PORT=5000
FRONTEND_URL=http://127.0.0.1:5174
API_PUBLIC_URL=http://127.0.0.1:5000
JSON_BODY_LIMIT=8mb
UPLOAD_MAX_BYTES=3145728

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=crm_pme
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=2h

EMAIL_USER=
EMAIL_PASS=

# Relance des clients sans achat: 24 heures en test, 168 en production.
PROSPECT_FOLLOWUP_HOURS=24

# Relance des clients ayant deja achete mais inactifs depuis X jours.
INACTIVE_CLIENT_EMAIL_DAYS=7

# Rappel de dette: en production, premier email apres X jours, puis au maximum un email par intervalle.
DEBT_REMINDER_MIN_AGE_DAYS=7
DEBT_REMINDER_INTERVAL_DAYS=7
# Test rapide: decommenter pour envoyer les rappels de dette toutes les 3 minutes.
# DEBT_REMINDER_MIN_AGE_MINUTES=0
# DEBT_REMINDER_INTERVAL_MINUTES=3

# IA du chat: ne jamais exposer cette cle dans le frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Paiement automatique: renseigner les identifiants du prestataire choisi.
MOBILE_MONEY_PROVIDER_URL=
MOBILE_MONEY_PROVIDER_KEY=
MOBILE_MONEY_CALLBACK_URL=

# Stripe test: la cle secrete reste uniquement cote backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
