PORT=5000
FRONTEND_URL=http://127.0.0.1:5174

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=crm_pme
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=2h

EMAIL_USER=
